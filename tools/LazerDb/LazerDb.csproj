<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LazerDb</AssemblyName>
    <RootNamespace>LazerDb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- pinned on purpose: the realm schema version must match the installed osu!lazer
         build or the tool refuses to open the database (see Program.cs) -->
    <PackageReference Include="ppy.osu.Game" Version="2026.916.0" />
    <!-- the rulesets are needed for beatmap parsing: without them loaded, the legacy
         .osu decoder cannot instantiate a game mode and every map fails to parse
         ("No valid beatmap files found in the beatmap archive") -->
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.916.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

</Project>
